# Środowisko aplikacji: development | preview | production
# Domyślnie: development przy `npm run dev`, production przy `npm run build`
VITE_APP_ENV=development

# Publiczny adres aplikacji (bez ukośnika na końcu)
# Domyślnie: adres, pod którym aplikacja jest otwarta
VITE_SITE_URL=http://localhost:5173