# ---------------------------------------------
# Dependencies
# ---------------------------------------------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
!.yarn/plugins
.npm/

# Keep the lockfile in git (package-lock.json is NOT ignored on purpose).

# ---------------------------------------------
# Build output (Vite)
# ---------------------------------------------
dist/
dist-ssr/
*.local
.vite/
# Vite timestamp files created when the config fails to load
vite.config.*.timestamp-*

# Histoire / Storybook (component previews)
.histoire/
storybook-static/

# ---------------------------------------------
# Tests
# ---------------------------------------------
# Vitest coverage
coverage/
*.lcov
.nyc_output/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Lighthouse CI
.lighthouseci/

# ---------------------------------------------
# Environment and secrets
# ---------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Sentry CLI config (may contain auth tokens)
.sentryclirc

# ---------------------------------------------
# Hosting / deploy tools
# ---------------------------------------------
.netlify/
.vercel/
.wrangler/
.fly/

# ---------------------------------------------
# Server (stage 7): local database, uploads
# ---------------------------------------------
*.sqlite
*.sqlite3
*.db
pgdata/
uploads/
tmp/

# ---------------------------------------------
# Content pipeline
# ---------------------------------------------
# Raw, unprocessed scans stay out of git (keep only processed images
# with confirmed licences in the repo).
content-raw/

# ---------------------------------------------
# Logs and caches
# ---------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
*.tsbuildinfo
.cache/
.temp/

# ---------------------------------------------
# Editors and IDEs
# ---------------------------------------------
# IntelliJ IDEA / WebStorm
.idea/
*.iml
*.iws
out/

# VS Code: ignore personal settings, keep shared ones
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ---------------------------------------------
# Operating systems
# ---------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
